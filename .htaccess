# Dataplanning — Apache (hosting Arsys)
# 1) Las URLs antiguas de WordPress (ES/CA/EN) redirigen a las secciones
#    en castellano, en el mismo orden que el navbar.
# 2) /somos/ /talento/ /aportamos/ /clientes/ /contacto/ sirven la landing
#    con título y canonical propios para los sitelinks de Google.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# HTTPS + www solo en producción
RewriteCond %{HTTP_HOST} ^(www\.)?dataplanning\.es$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.dataplanning.es%{REQUEST_URI} [R=301,L]

# index.html → raíz
RewriteRule ^index\.html$ / [R=301,L]

# --- WordPress: homes en otros idiomas ---
RewriteRule ^ca/?$ / [R=301,L]
RewriteRule ^en/?$ / [R=301,L]

# --- WordPress: páginas de sección (CA/EN y slugs largos) → navbar ES ---
RewriteRule ^(ca/som|en/we-are)/?$ /somos/ [R=301,L]
RewriteRule ^(ca/talent|en/talent)/?$ /talento/ [R=301,L]
RewriteRule ^(ca/aportem|en/we-provide)/?$ /aportamos/ [R=301,L]
RewriteRule ^(clientes-que-trabajan-con-nosotros|ca/clients-que-treballen-amb-nosaltres|en/customers-that-work-with-us)/?$ /clientes/ [R=301,L]
RewriteRule ^(ca/contacte|en/contact|contact)/?$ /contacto/ [R=301,L]

# --- Blog antiguo (ya no existe en la nueva web) ---
RewriteRule ^(ca/)?social/?$ / [R=301,L]
RewriteRule ^en/social/?$ / [R=301,L]
RewriteRule ^20[0-9]{2}/ / [R=301,L]

# --- Resto de /ca/ y /en/ ---
RewriteRule ^(ca|en)/ / [R=301,L]

# Sitemaps y feeds de Yoast/WP
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|category-sitemap)\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]

# Slash final en las secciones del navbar
RewriteRule ^(somos|talento|aportamos|clientes|contacto)$ /$1/ [R=301,L]

# Ficheros y carpetas reales (css, js, assets, php/contact.php…)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Secciones del navbar: misma página, SEO distinto
RewriteRule ^(somos|talento|aportamos|clientes|contacto)/$ /php/render-page.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
